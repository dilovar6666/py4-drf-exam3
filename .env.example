DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174

POSTGRES_DB=auto_anatomy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgresql-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Optional external providers. Server-side only; never expose keys in Vite config.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
EXA_API_KEY=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
BLENDER_EXECUTABLE=C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe
